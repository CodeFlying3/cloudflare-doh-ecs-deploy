{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloudflare-doh-ecs",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-03",
  "workers_dev": true,
  "vars": {
    "DOH_PATH": "/doh",
    "GLOBAL_DOH_URL": "https://dns.google/dns-query",
    "GLOBAL_FALLBACK_DOH_URL": "https://cloudflare-dns.com/dns-query",
  },
}
